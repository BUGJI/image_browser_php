# ============================================
# 图片浏览器环境配置模板
# 复制本文件为 .env 并填写真实值
# .env 含敏感信息，切勿提交到版本库 / 公开分享
# ============================================

# --- 存储模式 ---
# webdav = 从远程 WebDAV 拉取原图并压缩进 webp_cache（默认，见下方配置）
# local  = 网站本地存放原图：直接展示 webp_cache 目录，不远程拉取、不启用同步
STORAGE_MODE=webdav

# --- 原图 WebDAV 代理 (api.php?action=original，仅 webdav 模式) ---
# 远程 WebDAV 服务器地址（图片素材根目录）
WEBDAV_BASE_URL=https://example.com:443/你的目录/图片素材
# WebDAV 用户名
WEBDAV_USERNAME=your_username
# WebDAV 密码
WEBDAV_PASSWORD=your_password

# --- Admin 面板 (admin.php) ---
# 访问 http://你的地址/admin.php 的管理口令，请改成强随机值
ADMIN_TOKEN=change_me_to_a_long_random_string

# --- WebDAV 同步任务 (sync_webdav.php, 仅 STORAGE_MODE=webdav) ---
# 白名单 / 黑名单 / 压缩质量 / 最大宽度 都在 admin 面板配置，保存于 .sync_config.json
# （优先级：admin 面板保存 > 内置默认）。这里只保留每批处理文件数。
# 每批处理的文件数（前端轮询模式；CLI 模式忽略）
SYNC_BATCH_SIZE=50

